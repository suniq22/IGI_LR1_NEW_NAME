[run]
source = users,main,cargo
omit =
    */migrations/*
    */management/*
    */tests.py
    */tests/*
    */apps.py
    */__init__.py
    cargo_project/*
    manage.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if settings.DEBUG
