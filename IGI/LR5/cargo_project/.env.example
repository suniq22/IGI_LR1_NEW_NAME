DJANGO_SECRET_KEY=change-me-please
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# Set USE_POSTGRES=True to use Postgres (docker-compose). Leave False/unset for SQLite.
USE_POSTGRES=False
POSTGRES_DB=cargo_db
POSTGRES_USER=cargo_user
POSTGRES_PASSWORD=cargo_pass
POSTGRES_HOST=db
POSTGRES_PORT=5432
